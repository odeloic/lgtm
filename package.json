{
  "name": "@odeloic/lgtm",
  "version": "0.1.0",
  "description": "Local agentic review tool",
  "type": "module",
  "bin": {
    "lgtm": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:web": "npm --prefix web run build",
    "typecheck:web": "npm --prefix web run typecheck",
    "prepack": "npm run build && npm run build:web"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.2"
  },
  "license": "MIT",
  "homepage": "https://github.com/odeloic/lgtm#readme",
  "bugs": {
    "url": "https://github.com/odeloic/lgtm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odeloic/lgtm.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "code-review",
    "agent"
  ]
}
